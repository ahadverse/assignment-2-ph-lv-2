{
  "info": {
    "name": "DevPulse API",
    "description": "Internal Tech Issue & Feature Tracker",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "token",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Signup",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"John Doe\",\n  \"email\": \"john@devpulse.com\",\n  \"password\": \"password123\",\n  \"role\": \"contributor\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "http://localhost:5000/api/auth/signup",
              "protocol": "http",
              "host": ["localhost"],
              "port": "5000",
              "path": ["api", "auth", "signup"]
            }
          }
        },
        {
          "name": "Signup (Maintainer)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Jane Admin\",\n  \"email\": \"jane@devpulse.com\",\n  \"password\": \"admin123\",\n  \"role\": \"maintainer\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "http://localhost:5000/api/auth/signup",
              "protocol": "http",
              "host": ["localhost"],
              "port": "5000",
              "path": ["api", "auth", "signup"]
            }
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.data && res.data.token) {",
                  "  pm.collectionVariables.set('token', res.data.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"john@devpulse.com\",\n  \"password\": \"password123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "http://localhost:5000/api/auth/login",
              "protocol": "http",
              "host": ["localhost"],
              "port": "5000",
              "path": ["api", "auth", "login"]
            }
          }
        }
      ]
    },
    {
      "name": "Issues",
      "item": [
        {
          "name": "Get All Issues",
          "request": {
            "method": "GET",
            "url": {
              "raw": "http://localhost:5000/api/issues?sort=newest",
              "protocol": "http",
              "host": ["localhost"],
              "port": "5000",
              "path": ["api", "issues"],
              "query": [
                {
                  "key": "sort",
                  "value": "newest"
                },
                {
                  "key": "type",
                  "value": "bug",
                  "disabled": true
                },
                {
                  "key": "status",
                  "value": "open",
                  "disabled": true
                }
              ]
            }
          }
        },
        {
          "name": "Get Single Issue",
          "request": {
            "method": "GET",
            "url": {
              "raw": "http://localhost:5000/api/issues/1",
              "protocol": "http",
              "host": ["localhost"],
              "port": "5000",
              "path": ["api", "issues", "1"]
            }
          }
        },
        {
          "name": "Create Issue",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "{{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Database connection timeout under load\",\n  \"description\": \"Pool exhausts after 50+ concurrent queries, causing 500 errors in production\",\n  \"type\": \"bug\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "http://localhost:5000/api/issues",
              "protocol": "http",
              "host": ["localhost"],
              "port": "5000",
              "path": ["api", "issues"]
            }
          }
        },
        {
          "name": "Update Issue",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "{{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Updated: Database pool exhaustion fix needed\",\n  \"description\": \"Updated description with full reproduction steps and environment details\",\n  \"type\": \"bug\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "http://localhost:5000/api/issues/1",
              "protocol": "http",
              "host": ["localhost"],
              "port": "5000",
              "path": ["api", "issues", "1"]
            }
          }
        },
        {
          "name": "Update Issue Status (Maintainer)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "{{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"in_progress\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "http://localhost:5000/api/issues/1",
              "protocol": "http",
              "host": ["localhost"],
              "port": "5000",
              "path": ["api", "issues", "1"]
            }
          }
        },
        {
          "name": "Delete Issue (Maintainer)",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "{{token}}"
              }
            ],
            "url": {
              "raw": "http://localhost:5000/api/issues/1",
              "protocol": "http",
              "host": ["localhost"],
              "port": "5000",
              "path": ["api", "issues", "1"]
            }
          }
        }
      ]
    }
  ]
}
